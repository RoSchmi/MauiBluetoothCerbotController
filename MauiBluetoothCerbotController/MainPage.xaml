<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiBluetoothCerbotController.MainPage"
             xmlns:pagemodel="clr-namespace:MauiBluetoothCerbotController"
             xmlns:viewmodels="clr-namespace:MauiBluetoothCerbotController.ViewModels"
             x:DataType="viewmodels:MainPageViewModel">

    


    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <HorizontalStackLayout Margin="0,20,0,0"  Spacing="10" VerticalOptions="Start">
                <Label Text="Connect to BLE-Device"
           VerticalOptions="Center" FontAttributes="Bold"/>

                <Picker  BackgroundColor="BlanchedAlmond"
                         MinimumWidthRequest="200"
            ItemsSource="{Binding Devices}"
            ItemDisplayBinding="{Binding Name}"
            SelectedItem="{Binding SelectedDevice}" />

                <BoxView WidthRequest="20"
             HeightRequest="20"
             CornerRadius="4"
             VerticalOptions="Center"
             Color="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" />
            </HorizontalStackLayout>

            <Image
                Source="ghi_cerbot_2.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="GHI Electronics Cerbot" />

            <Label
                Text="Hello, GHI FEZ Cerbot"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Welcome back &#10;.NET Maui App steering FEZ Cerbot"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Welcome to dot net Multi platform App U I" />
            <HorizontalStackLayout Spacing="5">
                <Button Text="{Binding Text_No_1}"  Command="{Binding Play_No_1Command}"/>
                <Button Text="{Binding Text_No_2}"  Command="{Binding Play_No_2Command}"/>
                <Button Text="{Binding Text_No_3}"  Command="{Binding Play_No_3Command}"/>
                <Button Text="{Binding Text_No_4}"  Command="{Binding Play_No_4Command}"/>
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="200,*"
                RowDefinitions="Auto"
                ColumnSpacing="20"
                Margin="0,10,0,0">
                <!-- ⭐ LINKES LOG-FENSTER -->
                <CollectionView
                        Grid.Column="0"
                        ItemsSource="{Binding LogLines}"
                        BackgroundColor="#C8DCD0"
                        VerticalScrollBarVisibility="Always"
                        HeightRequest="120"
                        Margin="0,0,0,0">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding}"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    TextColor="Black"
                                    Padding="2,0"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ⭐ RECHTS: DEIN STEUER-GRID (unverändert, aber zentriert) -->
                <Grid Grid.Column="1"
          RowDefinitions="Auto,Auto,Auto"
          ColumnDefinitions="*,Auto,*, 200"
          ColumnSpacing="10"
          RowSpacing="10"
          HorizontalOptions="Center"
          VerticalOptions="Center">

                    <!-- Zeile 1: Vorwärts -->
                    <Button Grid.Row="0" Grid.Column="1"
                WidthRequest="100"
                Text="Vorwärts"
                Command="{Binding MoveForwardCommand}" />

                    <!-- Zeile 2: Links / Stop / Rechts -->
                    <Button Grid.Row="1" Grid.Column="0"
                Text="Links"
                Command="{Binding TurnLeftCommand}" />

                    <Button Grid.Row="1" Grid.Column="1"
                Text="Stop"
                Command="{Binding StopCommand}" />

                    <Button Grid.Row="1" Grid.Column="2"
                Text="Rechts"
                Command="{Binding TurnRightCommand}" />

                    <!-- Zeile 3: Rückwärts -->
                    <Button Grid.Row="2" Grid.Column="1"
                WidthRequest="100"
                Text="Rückwärts"
                Command="{Binding MoveBackwardCommand}" />
                </Grid>
            </Grid>
            
            <Button
                x:Name="CounterBtn"
                Text="Zwick me" 
                Command="{Binding ZwickMeCommand}"              
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
